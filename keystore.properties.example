# Copy this file to keystore.properties (gitignored) and fill in your values.
#
# Generate a keystore if you don't have one:
#   keytool -genkey -v -keystore /path/to/buildwatch-release.jks \
#     -alias buildwatch -keyalg RSA -keysize 2048 -validity 10000
#
# Firebase App ID — found in Firebase console → Project settings → Your apps
#   (format: 1:1234567890:android:abcdef1234567890)

storeFile=/path/to/buildwatch-release.jks
storePassword=changeme
keyAlias=buildwatch
keyPassword=changeme
firebaseAppId=1:1234567890:android:abcdef1234567890
